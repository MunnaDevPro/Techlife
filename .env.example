# TechLife Environment Configuration Example
# Copy this file to .env for local environment configuration.
# DO NOT commit real secrets or credentials to version control.

SECRET_KEY=django-insecure-development-placeholder-key

# Automation Identity & n8n Publishing Configuration
# TECHLIFE_AUTOMATION_TOKEN: Required secret token used for n8n API publishing (Authorization: Automation <token>)
TECHLIFE_AUTOMATION_TOKEN=your_secure_automation_token_here

# TECHLIFE_AUTOMATION_AUTHOR_USERNAME: Username of the normal TechLife user profile that owns automated posts
TECHLIFE_AUTOMATION_AUTHOR_USERNAME=techlife_desk

# Automation Guardrails & Rate Limits
TECHLIFE_AUTOMATION_ENABLED=True
TECHLIFE_AUTOMATION_DAILY_POST_LIMIT=4
TECHLIFE_AUTOMATION_HOURLY_REQUEST_LIMIT=20
TECHLIFE_AUTOMATION_TIMEZONE=Asia/Dhaka

# Automation Image Localization Settings (SSRF Guard & Image Processing)
AUTOMATION_IMAGE_MAX_BYTES=8388608
AUTOMATION_IMAGE_CONNECT_TIMEOUT=5
AUTOMATION_IMAGE_READ_TIMEOUT=15
AUTOMATION_IMAGE_MAX_REDIRECTS=3
AUTOMATION_IMAGE_MAX_WIDTH=1600
AUTOMATION_IMAGE_MAX_HEIGHT=1200
AUTOMATION_IMAGE_WEBP_QUALITY=82
